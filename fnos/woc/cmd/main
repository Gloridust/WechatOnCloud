#!/bin/bash
# fnOS Docker app lifecycle. App Center starts/stops compose; status checks panel container.
set -u

CONTAINER="woc-panel"

is_running() {
  [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = "true" ]
}

case "${1:-}" in
  start)
    exit 0
    ;;
  stop)
    exit 0
    ;;
  status)
    if is_running; then exit 0; else exit 3; fi
    ;;
  *)
    exit 0
    ;;
esac
